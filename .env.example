PORT=3000
MONGO_URI=mongodb://mongodb:27017/cours_db?directConnection=true
TARGET_URL=http://backend:3000
# Auth : envoi des emails de réinitialisation de mot de passe (Mailpit en dev : http://localhost:8025)
SMTP_URL=smtp://mailpit:1025
APP_URL=http://localhost:3001
# Connexion Google (optionnelle, le bouton n'apparaît que si les deux sont renseignés)
# URI de redirection autorisée à déclarer dans Google Cloud : ${APP_URL}/api/session/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
