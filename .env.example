PORT=3000
# Secret HMAC des sessions, 32 caractères minimum, obligatoire hors NODE_ENV=test : openssl rand -base64 48
SESSION_SECRET=
# MongoDB : compte root (init uniquement) et comptes applicatifs à moindre privilège créés par database/00-init-roles.js
# Mots de passe alphanumériques (ils sont insérés tels quels dans l'URI de connexion) : openssl rand -hex 24
# Les comptes ne sont créés qu'au premier démarrage : sur un volume existant, `docker compose down -v` avant de relancer
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# cineslotMaster : BDD maître, insert/find seulement sur reservation_logs et audit_logs
MONGO_MASTER_PASSWORD=
# cineslotTenant : slots et bookings des BDD cinema_<slug>, aucun droit sur cineslot_master
MONGO_TENANT_PASSWORD=
# cineslotPurge : purge des BDD tenant à J+60
MONGO_PURGE_PASSWORD=
# Hors Docker uniquement (docker-compose construit l'URI avec cineslotMaster) ; Mongo n'est pas publié sur l'hôte par défaut
MONGO_URI=mongodb://cineslotMaster:<MONGO_MASTER_PASSWORD>@localhost:27017/cours_db?authSource=admin&directConnection=true
MONGO_MASTER_URI=mongodb://cineslotMaster:<MONGO_MASTER_PASSWORD>@localhost:27017/?authSource=admin&directConnection=true
MONGO_TENANT_URI=mongodb://cineslotTenant:<MONGO_TENANT_PASSWORD>@localhost:27017/?authSource=admin&directConnection=true
# Clé HMAC du chaînage des audit_logs, 32 caractères minimum : openssl rand -base64 48
AUDIT_KEY=
# Routes de démonstration (création de séances, reset) : false par défaut, ne jamais activer en production
ENABLE_DEMO_ROUTES=false
TARGET_URL=http://backend:3000
# Auth : envoi des emails de réinitialisation de mot de passe (Mailpit en dev : http://localhost:8025)
SMTP_URL=smtp://mailpit:1025
# Domaine racine (apex) : pas localhost, nginx le redirige sans query string et le cookie OAuth est posé sur .cineslot.localhost
APP_URL=http://cineslot.localhost:3001
# Connexion Google (optionnelle, le bouton n'apparaît que si les deux sont renseignés)
# URI de redirection autorisée à déclarer dans Google Cloud : http://localhost:3001/api/session/google/callback
# Google refuse http hors localhost : la connexion passe par localhost puis un jeton à usage unique ouvre la session sur le cinéma
GOOGLE_REDIRECT_URI=http://localhost:3001/api/session/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tests de charge k6 : compte SUPER_ADMIN créé par backend/scripts/create-admin.js, tenants ciblés via l'en-tête Host
K6_ADMIN_EMAIL=k6-admin@cineslot.test
K6_ADMIN_PASSWORD=
K6_ROOT_DOMAIN=cineslot.localhost:3001
K6_TENANTS=cine-bellecour,cine-part-dieu
