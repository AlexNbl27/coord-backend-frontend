{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST CRUD Express & Mongoose connectée à MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --import ./src/tracing.js src/server.js",
    "dev": "node --watch --import ./src/tracing.js src/server.js",
    "test": "node --test test/**/*.test.js",
    "test:coverage": "node -e \"fs.mkdirSync('coverage', {recursive: true})\" && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout test/**/*.test.js",
    "lint": "eslint .",
    "audit:verify": "node scripts/verify-audit-chain.js",
    "migrate:tenancy": "node scripts/migrate-to-multitenant.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.7.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "pdfjs-dist": "^6.5.438"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
